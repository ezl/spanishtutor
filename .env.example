# ============================================================
# DISCORD — Dev Server (agent/deploy bot)
# Get from: discord.com/developers/applications → your app → Bot
# ============================================================
DISCORD_DEV_BOT_TOKEN=                  # Bot token for the dev server bot
DISCORD_DEV_FEATURES_CHANNEL_ID=        # #features channel ID
DISCORD_DEV_CHANNEL_ID=                 # #dev channel ID
DISCORD_DEV_DEPLOY_CHANNEL_ID=          # #deploy channel ID
DISCORD_DEV_BUGS_CHANNEL_ID=            # #bugs channel ID
DISCORD_DEV_LOGS_CHANNEL_ID=            # #logs channel ID

# ============================================================
# DISCORD — Learning Server (tutor bot)
# Get from: discord.com/developers/applications → your app → Bot
# ============================================================
DISCORD_TUTOR_BOT_TOKEN=                # Bot token for the learning bot
DISCORD_TUTOR_LESSONS_CHANNEL_ID=       # #lessons channel ID
DISCORD_TUTOR_PROGRESS_CHANNEL_ID=      # #progress channel ID
DISCORD_TUTOR_CURRICULUM_CHANNEL_ID=    # #curriculum channel ID
DISCORD_TUTOR_FEEDBACK_CHANNEL_ID=      # #feedback channel ID

# ============================================================
# ANTHROPIC
# Get from: console.anthropic.com → API Keys
# ============================================================
ANTHROPIC_API_KEY=                      # Claude API key

# ============================================================
# DATABASE
# Get from: Railway (or wherever Postgres is hosted)
# Format: postgresql://user:password@host:port/dbname
# ============================================================
DATABASE_URL=                           # Full Postgres connection string

# ============================================================
# GITHUB
# Get from: github.com → Settings → Developer Settings → Personal Access Tokens → Fine-grained
# Permissions needed: Contents (read/write), Pull Requests (read/write)
# ============================================================
GITHUB_TOKEN=                           # Personal access token for repo access
GITHUB_REPO=                            # Format: username/spanishtutor

# ============================================================
# SERVER
# ============================================================
SERVER_IP=5.78.211.212                  # Hetzner VPS IP
